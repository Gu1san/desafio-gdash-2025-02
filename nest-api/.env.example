# Porta da API
PORT=3000

# URL de conexão com o MongoDB
# (troque o host para "mongo" quando estiver usando Docker)
MONGO_URI=mongodb://mongo:27017/weatherdb

# JWT Secret — nunca coloque o real no .example
JWT_SECRET=CHANGE_ME

# Usuário admin criado automaticamente no bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=123456

# IA habilitada/desabilitada
AI_ENABLED=true

# Nível de logs
LOG_LEVEL=debug
