# URL completa de conexão com o RabbitMQ
RABBITMQ_URL=

# Nome da fila consumida pelo worker
QUEUE_NAME=weather.raw

# URL da API Nest que receberá os logs
NEST_API_URL=

# Timeout em segundos para requisições HTTP
HTTP_TIMEOUT_SECONDS=10

# Tentativas de retry ao enviar para a API
POST_RETRIES=3
POST_RETRY_DELAY_SECONDS=2
